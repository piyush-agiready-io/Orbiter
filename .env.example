# Cloudflare R2 (optional for local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=orbiter-uploads
R2_PUBLIC_URL=

# Email (optional for local dev)
